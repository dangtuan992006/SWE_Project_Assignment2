@startuml BrewLite_Domain_Class_Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class Category {
  - id: UUID
  - name: String
  - description: String [0..1]
  - createdAt: DateTime
  - updatedAt: DateTime
}

class User {
  - id: UUID
  - email: String
  - passwordHash: String
  - fullName: String [0..1]
  - role: Role = CUSTOMER
  - loyaltyPoints: Integer = 0
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + addLoyaltyPoints(points: Integer): void
  + createOrder(items: List<OrderDetail>, checkoutKey: String): Order
}

class Product {
  - id: UUID
  - name: String
  - description: String [0..1]
  - imageUrl: String [0..1]
  - priceS: Decimal
  - priceM: Decimal
  - priceL: Decimal
  - toppingOptions: JSON = []
  - stock: Integer = 0
  - isAvailable: Boolean = true
  - version: Integer = 0
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + getPrice(size: Size, toppingIds: List<String>): Decimal
  + decreaseStock(quantity: Integer): void
}

class Order {
  - id: UUID
  - orderNumber: Integer
  - checkoutKey: String
  - status: OrderStatus = PENDING
  - subtotal: Decimal
  - discountAmount: Decimal = 0
  - totalAmount: Decimal
  - voucherCode: String [0..1]
  - note: String [0..1]
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + applyVoucher(voucher: Voucher, now: DateTime): void
  + calculateTotal(): Decimal
  + changeStatus(newStatus: OrderStatus): void
}

class OrderDetail <<OrderItem>> {
  - id: UUID
  - productName: String
  - size: Size
  - quantity: Integer
  - selectedToppings: JSON = []
  - unitPrice: Decimal
  - subtotal: Decimal
  --
  + calculateSubtotal(): Decimal
}

class Payment {
  - id: UUID
  - attemptNumber: Integer = 1
  - idempotencyKey: String
  - paymentMethod: PaymentMethod
  - provider: String = "MOCK"
  - amount: Decimal
  - status: PaymentStatus = PENDING
  - transactionCode: String [0..1]
  - paymentUrl: String [0..1]
  - expiresAt: DateTime [0..1]
  - errorCode: String [0..1]
  - errorMessage: String [0..1]
  - createdAt: DateTime
  - updatedAt: DateTime
  - completedAt: DateTime [0..1]
  - refundedAt: DateTime [0..1]
  --
  + markSucceeded(transactionCode: String, completedAt: DateTime): void
  + markFailed(errorCode: String, errorMessage: String, completedAt: DateTime): void
  + markRefunded(refundedAt: DateTime): void
}

class Voucher {
  - id: UUID
  - code: String
  - discountType: DiscountType
  - discountValue: Decimal
  - minOrderValue: Decimal [0..1]
  - maxDiscount: Decimal [0..1]
  - usageLimit: Integer [0..1]
  - usedCount: Integer = 0
  - startDate: DateTime [0..1]
  - endDate: DateTime [0..1]
  - isActive: Boolean = true
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + isApplicable(subtotal: Decimal, now: DateTime): Boolean
  + calculateDiscount(subtotal: Decimal): Decimal
  + recordUsage(): void
}

class LoyaltyTransaction {
  - id: UUID
  - points: Integer
  - type: TransactionType
  - createdAt: DateTime
  --
  + {static} createEarned(user: User, order: Order, points: Integer): LoyaltyTransaction
  + {static} createRedeemed(user: User, points: Integer): LoyaltyTransaction
}

class Ingredient {
  - id: UUID
  - name: String
  - unit: String
  - stock: Decimal = 0
  - minThreshold: Decimal = 100
  - createdAt: DateTime
  - updatedAt: DateTime
}

class RecipeItem {
  - id: UUID
  - size: Size
  - amount: Decimal
  - createdAt: DateTime
  - updatedAt: DateTime
}

class RefundRequest {
  - id: UUID
  - amount: Decimal
  - reason: String [0..1]
  - status: RefundRequestStatus = PENDING
  - processedBy: String [0..1]
  - processedAt: DateTime [0..1]
  - createdAt: DateTime
  - updatedAt: DateTime
}

class IngredientAuditLog {
  - id: UUID
  - ingredientId: String [0..1]
  - ingredientName: String
  - action: IngredientLogAction
  - changeAmount: Decimal [0..1]
  - previousStock: Decimal [0..1]
  - newStock: Decimal [0..1]
  - unit: String
  - reason: String [0..1]
  - performedBy: String [0..1]
  - createdAt: DateTime
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  E_WALLET
  BANK_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum TransactionType {
  EARN
  REDEEM
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IngredientLogAction {
  CREATE
  RESTOCK
  UPDATE
  DELETE
  ORDER_DEDUCT
}

Category "1" -- "0..*" Product : classifies
User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderDetail : contains
Product "1" -- "0..*" OrderDetail : references
Order "1" -- "0..3" Payment : payment attempts
Voucher "0..1" -- "0..*" Order : applied to
User "1" -- "0..*" LoyaltyTransaction : receives
Order "0..1" -- "0..*" LoyaltyTransaction : earns / links
Product "1" -- "0..*" RecipeItem : recipe for
Ingredient "1" -- "0..*" RecipeItem : consumed by
Order "1" -- "0..1" RefundRequest : refund request
User "1" -- "0..*" RefundRequest : submits
IngredientAuditLog ..> Ingredient : snapshot ref

User ..> Role
Product ..> Size
OrderDetail ..> Size
RecipeItem ..> Size
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Voucher ..> DiscountType
LoyaltyTransaction ..> TransactionType
RefundRequest ..> RefundRequestStatus
IngredientAuditLog ..> IngredientLogAction

@enduml
